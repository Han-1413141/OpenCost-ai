{
  "name": "opencost-clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenCost website, desktop journal, contribution tools and Skills",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-integration.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "contribute": "tsx client/cli.ts",
    "monitor": "tsx client/monitor-cli.ts",
    "desktop:build": "tsc -p tsconfig.desktop.json && node scripts/build-desktop.mjs",
    "desktop:start": "electron desktop-dist/main.cjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^44.7.0",
    "esbuild": "0.28.2",
    "rolldown": "1.2.13",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
